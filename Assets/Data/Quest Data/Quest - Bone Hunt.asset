  questName: 
  questDescription: "Those rattling piles of bones have been causing trouble again,
    and I\u2019ve got a business opportunity that\u2019s too good to pass up! Head
    into the nearby crypts, caves, or graveyard and put down some skeletons. Bring
    me their bones. Clean, intact ones if you can. I\u2019ve got customers who\u2019ll
    pay good coin for quality bone, and frankly, the dead are terrible at negotiating."
  questObjective: '- Eliminate 2 skeletons'
  questTargetID: enemy_skeleton
  requiredAmount: 2
  rewardGiver: 0
  questRewards: []
  goldReward: 100
